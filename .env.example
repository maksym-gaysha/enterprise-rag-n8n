# Core Application Settings
PROJECT_NAME="enterprise-rag-n8n"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL with pgvector)
POSTGRES_USER=postgres
